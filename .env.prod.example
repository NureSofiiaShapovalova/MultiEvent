POSTGRES_DB=eventflow
POSTGRES_USER=eventflow
POSTGRES_PASSWORD=replace_with_strong_database_password

APP_HOST_PORT=8080
APP_PUBLIC_BASE_URL=https://your-domain.example

EVENTFLOW_MAIL_HOST=smtp.example.com
EVENTFLOW_MAIL_PORT=587
EVENTFLOW_MAIL_USERNAME=replace_with_smtp_username
EVENTFLOW_MAIL_PASSWORD=replace_with_smtp_password
EVENTFLOW_MAIL_FROM=no-reply@your-domain.example
EVENTFLOW_MAIL_SMTP_AUTH=true
EVENTFLOW_MAIL_SMTP_STARTTLS=true

EVENTFLOW_PAYMENT_PROVIDER=paypal
PAYPAL_MODE=live
PAYPAL_CLIENT_ID=replace_with_paypal_client_id
PAYPAL_CLIENT_SECRET=replace_with_paypal_client_secret
PAYPAL_WEBHOOK_ID=replace_with_paypal_webhook_id
PAYPAL_CURRENCY=EUR

EVENTFLOW_IMAGE=eventflow-app:latest

POSTGRES_DB=multievent
POSTGRES_USER=multievent
POSTGRES_PASSWORD=replace_with_strong_database_password

APP_HOST_PORT=8080
APP_PUBLIC_BASE_URL=https://your-domain.example

MULTIEVENT_MAIL_HOST=smtp.example.com
MULTIEVENT_MAIL_PORT=587
MULTIEVENT_MAIL_USERNAME=replace_with_smtp_username
MULTIEVENT_MAIL_PASSWORD=replace_with_smtp_password
MULTIEVENT_MAIL_FROM=no-reply@your-domain.example
MULTIEVENT_MAIL_SMTP_AUTH=true
MULTIEVENT_MAIL_SMTP_STARTTLS=true

MULTIEVENT_PAYMENT_PROVIDER=paypal
PAYPAL_MODE=live
PAYPAL_CLIENT_ID=replace_with_paypal_client_id
PAYPAL_CLIENT_SECRET=replace_with_paypal_client_secret
PAYPAL_WEBHOOK_ID=replace_with_paypal_webhook_id
PAYPAL_CURRENCY=EUR

MULTIEVENT_IMAGE=multievent-app:latest
